# Cloudflare Pages – cache para performance (PLANO-RESOLUCAO-PERFORMANCE)
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML: sempre revalidar para deploy aparecer na hora em producao
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# CSS e JS com query string (?v=) – cache longo (imutável por URL)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
