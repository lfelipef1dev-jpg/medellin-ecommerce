# ========== Mercado Pago ==========
# Token de PRODUÇÃO. Painel: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ========== URLs (produção) ==========
# Site (retorno após pagamento)
FRONT_URL=https://roleplaymedellin.com.br
# Webhook (HTTPS). Onde o MP envia a notificação. Ex: subdomínio api.roleplaymedellin.com.br
WEBHOOK_URL=https://api.roleplaymedellin.com.br/api/webhook/mp

# ========== MySQL (mesmo do FiveM) ==========
# A tabela medellin_loja_pending deve existir no banco
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=qbcore

# ========== Porta ==========
PORT=3000

# (Opcional) Token para a página entregar-duas-skins.html. Se definir, exige o token no envio.
# ENTREGA_MANUAL_TOKEN=seu_token_secreto

# (Opcional) Endpoint HTTP do FiveM para entrega imediata. Ex: http://localhost:30120/medellin-loja-entregas/deliver
# Se não configurado, entregas serão processadas pela fila normal (até 45s)
# FIVEM_DELIVERY_ENDPOINT=http://localhost:30120/medellin-loja-entregas/deliver
