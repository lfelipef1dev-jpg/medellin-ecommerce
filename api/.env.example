# Mercado Pago – Access Token
MP_ACCESS_TOKEN=SEU_MP_ACCESS_TOKEN_AQUI

# Mercado Pago – Webhook Secret (obtenha em: MP Dashboard > Webhooks > Secret Key)
# OBRIGATORIO em producao para validar assinatura HMAC dos webhooks
MP_WEBHOOK_SECRET=SEU_MP_WEBHOOK_SECRET_AQUI

# URL do webhook (deve ser HTTPS e apontar para ESTA API, não para o site estático)
# Se apontar para roleplaymedellin.com.br o MP envia para o Workers e a API nunca recebe → skin não entrega
WEBHOOK_URL=SEU_WEBHOOK_URL_AQUI

# URL do site (para back_urls do checkout – retorno após pagamento)
FRONT_URL=SEU_FRONT_URL_AQUI

# MySQL – mesmo banco do servidor FiveM (medellin_loja_pending já existe)
DB_HOST=SEU_DB_HOST_AQUI
DB_USER=SEU_DB_USER_AQUI
DB_PASSWORD=SEU_DB_PASSWORD_AQUI
DB_NAME=SEU_DB_NAME_AQUI

# Porta da API (opcional)
PORT=SEU_PORT_AQUI
